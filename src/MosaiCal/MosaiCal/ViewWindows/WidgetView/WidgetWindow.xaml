<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="MosaiCal.ViewWindows.WidgetView.WidgetWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="MosaiCal Widget"
    >

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.Resources>
            <DataTemplate x:Key="SettingsSectionHeaderTemplate">
                <TextBlock Text="{Binding}"
                           FontSize="18"
                           FontWeight="Bold" />
            </DataTemplate>

            <DataTemplate x:Key="SourceCardTemplate">
                <Border Background="{Binding BackgroundBrush}"
                        RequestedTheme="{Binding CardTheme}"
                        CornerRadius="12"
                        BorderThickness="1"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                    <Grid>
                        <Border CornerRadius="11"
                                Background="Black"
                                Opacity="{Binding DarknessOverlayOpacity}"
                                Visibility="{Binding ImageOverlayVisibility}" />
                        <Border CornerRadius="11" Visibility="{Binding ImageOverlayVisibility}">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                    <GradientStop Color="#CC000000" Offset="0" />
                                    <GradientStop Color="#66000000" Offset="0.6" />
                                    <GradientStop Color="#33000000" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <Grid Padding="12" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="4">
                            <StackPanel Spacing="8" Opacity="{Binding ContentOpacity}">
                                <TextBlock Text="{Binding DisplayName}" FontSize="18" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding StatusText}" Opacity="0.8" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <ToggleSwitch IsOn="{Binding IsVisible, Mode=OneWay}"
                                              OnContent="Shown"
                                              OffContent="Hidden"
                                              MinWidth="0"
                                              AutomationProperties.Name="Show events from this group"
                                              Toggled="SourceVisibilityToggled" />
                                <Button Content="Pick color"
                                        Click="PickBackgroundColorClick"
                                        Visibility="{Binding PickColorVisibility}" />
                                <Button Content="Pick image" Click="ChooseBackgroundImageClick" />
                                <Button Content="Remove image"
                                        Click="RemoveBackgroundImageClick"
                                        Visibility="{Binding RemoveImageVisibility}" />
                            </StackPanel>
                            <Grid Grid.Row="1"
                                  Grid.ColumnSpan="2"
                                  ColumnSpacing="12"
                                  ColumnDefinitions="Auto,*,Auto"
                                  Visibility="{Binding RemoveImageVisibility}">
                                <TextBlock Text="Image darkness" VerticalAlignment="Center" />
                                <Slider Grid.Column="1"
                                        Minimum="0"
                                        Maximum="90"
                                        StepFrequency="5"
                                        TickFrequency="10"
                                        Value="{Binding ImageDarkness, Mode=OneWay}"
                                        AutomationProperties.Name="Image darkness"
                                        ValueChanged="ImageDarknessChanged" />
                                <TextBlock Grid.Column="2"
                                           Text="{Binding ImageDarknessText}"
                                           MinWidth="36"
                                           TextAlignment="Right"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>
            </DataTemplate>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid x:Name="AppTitleBar"
              Grid.Row="0"
              Height="48"
              Padding="16,0,0,0"
              ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Image Source="ms-appx:///Assets/mosaical-icon.png"
                   Width="18"
                   Height="18"
                   VerticalAlignment="Center"
                   AutomationProperties.AccessibilityView="Raw"/>
            <TextBlock Grid.Column="1"
                       Text="MosaiCal"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       VerticalAlignment="Center"/>
        </Grid>

        <muxc:NavigationView x:Name="SettingsNav"
                             Grid.Row="1"
                             PaneDisplayMode="Auto"
                             ExpandedModeThresholdWidth="720"
                             OpenPaneLength="200"
                             IsBackButtonVisible="Collapsed"
                             IsSettingsVisible="False"
                             IsTitleBarAutoPaddingEnabled="False"
                             Header="General"
                             SelectionChanged="SettingsNavSelectionChanged">
            <muxc:NavigationView.Resources>
                <Thickness x:Key="NavigationViewHeaderMargin">16,12,0,0</Thickness>
                <Thickness x:Key="NavigationViewContentMargin">0,0,8,8</Thickness>
                <Thickness x:Key="NavigationViewContentGridBorderThickness">1</Thickness>
                <CornerRadius x:Key="NavigationViewContentGridCornerRadius">8</CornerRadius>
            </muxc:NavigationView.Resources>
            <muxc:NavigationView.MenuItems>
                <muxc:NavigationViewItem Content="General" Tag="General">
                    <muxc:NavigationViewItem.Icon>
                        <muxc:SymbolIcon Symbol="Setting"/>
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem Content="Google" Tag="Google">
                    <muxc:NavigationViewItem.Icon>
                        <muxc:SymbolIcon Symbol="Calendar"/>
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem Content="Canvas" Tag="Canvas">
                    <muxc:NavigationViewItem.Icon>
                        <muxc:ImageIcon Source="ms-appx:///Assets/canvas-lms.png"/>
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
            </muxc:NavigationView.MenuItems>

            <Grid>
                <ScrollViewer x:Name="GeneralPage" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Padding="16" Spacing="8" HorizontalAlignment="Stretch">
                        <muxc:Expander Header="Sources"
                                      HeaderTemplate="{StaticResource SettingsSectionHeaderTemplate}"
                                      IsExpanded="True"
                                      HorizontalAlignment="Stretch"
                                      HorizontalContentAlignment="Stretch">
                            <StackPanel Spacing="12" Padding="8,4,8,8">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="Google Calendar" />
                                        <TextBlock x:Name="GoogleSourceStatus"
                                                   Text="Checking connection…"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                    <HyperlinkButton x:Name="GoogleSetupLink"
                                                     Grid.Column="1"
                                                     Content="Set up"
                                                     Tag="Google"
                                                     Click="SourceSetupClick"
                                                     VerticalAlignment="Center"
                                                     Visibility="Collapsed" />
                                    <ToggleSwitch x:Name="EnableGoogle"
                                                  Grid.Column="2"
                                                  OnContent="On"
                                                  OffContent="Off"
                                                  MinWidth="0"
                                                  IsEnabled="False"
                                                  AutomationProperties.Name="Use Google Calendar"
                                                  Toggled="GoogleToggled" />
                                </Grid>
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="Canvas Calendar" />
                                        <TextBlock x:Name="CanvasSourceStatus"
                                                   Text="Not set up"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                    <HyperlinkButton x:Name="CanvasSetupLink"
                                                     Grid.Column="1"
                                                     Content="Set up"
                                                     Tag="Canvas"
                                                     Click="SourceSetupClick"
                                                     VerticalAlignment="Center"
                                                     Visibility="Collapsed" />
                                    <ToggleSwitch x:Name="EnableCanvas"
                                                  Grid.Column="2"
                                                  OnContent="On"
                                                  OffContent="Off"
                                                  MinWidth="0"
                                                  IsEnabled="False"
                                                  AutomationProperties.Name="Use Canvas Calendar"
                                                  Toggled="CanvasToggled" />
                                </Grid>
                            </StackPanel>
                        </muxc:Expander>
                        <muxc:Expander Header="Views"
                                      HeaderTemplate="{StaticResource SettingsSectionHeaderTemplate}"
                                      IsExpanded="True"
                                      HorizontalAlignment="Stretch"
                                      HorizontalContentAlignment="Stretch">
                            <StackPanel Spacing="8" Padding="8,4,8,8">
                                <ComboBox x:Name="PrimaryViewSelector"
                                          Header="Calendar view"
                                          SelectionChanged="PrimaryViewChanged"
                                          HorizontalAlignment="Stretch">
                                    <ComboBoxItem Content="To-do list"/>
                                    <ComboBoxItem Content="Day"/>
                                    <ComboBoxItem Content="Week"/>
                                </ComboBox>
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Enable calendar view" VerticalAlignment="Center" />
                                    <ToggleSwitch x:Name="EnablePrimaryView"
                                                  Grid.Column="1"
                                                  OnContent="On"
                                                  OffContent="Off"
                                                  MinWidth="0"
                                                  AutomationProperties.Name="Enable calendar view"
                                                  Toggled="PrimaryViewToggled" />
                                </Grid>
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Pin calendar view" VerticalAlignment="Center" />
                                    <ToggleSwitch x:Name="EnablePinnedView"
                                                  Grid.Column="1"
                                                  OnContent="On"
                                                  OffContent="Off"
                                                  MinWidth="0"
                                                  AutomationProperties.Name="Pin calendar view"
                                                  Toggled="PinnedViewToggled" />
                                </Grid>
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Open calendar view at sign-in" VerticalAlignment="Center" />
                                    <ToggleSwitch x:Name="EnableStartAtSignIn"
                                                  Grid.Column="1"
                                                  OnContent="On"
                                                  OffContent="Off"
                                                  MinWidth="0"
                                                  IsEnabled="False"
                                                  AutomationProperties.Name="Open calendar view at sign-in"
                                                  Toggled="StartAtSignInToggled" />
                                </Grid>
                                <TextBlock x:Name="StartAtSignInMessage"
                                           TextWrapping="Wrap"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Visibility="Collapsed" />
                                <TextBlock x:Name="ViewSourceRequirementMessage"
                                           Text="Checking configured sources..."
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </muxc:Expander>
                        <muxc:Expander Header="Appearance"
                                      HeaderTemplate="{StaticResource SettingsSectionHeaderTemplate}"
                                      IsExpanded="True"
                                      HorizontalAlignment="Stretch"
                                      HorizontalContentAlignment="Stretch">
                            <StackPanel Spacing="16" Padding="8,4,8,8">
                                <muxc:RadioButtons x:Name="BkgStyleRadioSettings"
                                                   Header="Background style"
                                                   SelectedIndex="0"
                                                   SelectionChanged="BkgStyleChanged">
                                    <x:String>Solid</x:String>
                                    <x:String>Mica</x:String>
                                    <x:String>Acrylic</x:String>
                                </muxc:RadioButtons>
                                <muxc:NumberBox x:Name="WindowTransparencyInput"
                                                Header="Window transparency (%)"
                                                Minimum="0"
                                                Maximum="100"
                                                SmallChange="5"
                                                LargeChange="10"
                                                SpinButtonPlacementMode="Inline"
                                                ValidationMode="InvalidInputOverwritten"
                                                HorizontalAlignment="Left"
                                                MinWidth="160"
                                                ValueChanged="WindowTransparencyInputChanged" />
                            </StackPanel>
                        </muxc:Expander>
                    </StackPanel>
                </ScrollViewer>

                <Grid x:Name="GooglePage" Padding="16" Visibility="Collapsed">
                    <!-- Same structure as CanvasPage: connection, sync row, calendar list -->
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel x:Name="GoogleSignedOutPanel">
                            <Button x:Name="GoogleSI"
                                    Click="GoogleSIClick"
                                    AutomationProperties.Name="Sign in with Google"
                                    Padding="0"
                                    Margin="0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    CornerRadius="5">
                                <Image Source="ms-appx:///Assets/google-si-neutral.png"
                                       Width="175"
                                       Height="40"
                                       Stretch="Uniform" />
                            </Button>
                        </StackPanel>
                        <Border x:Name="GoogleAccountCard"
                                Visibility="Collapsed"
                                Padding="12"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8">
                            <Grid ColumnSpacing="12" RowSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition />
                                    <RowDefinition />
                                </Grid.RowDefinitions>
                                <Border Width="40" Height="40" CornerRadius="20">
                                    <Image x:Name="GoogleProfileImage" Stretch="UniformToFill" />
                                </Border>
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock x:Name="GoogleProfileNameText" FontWeight="SemiBold" />
                                    <TextBlock x:Name="GoogleProfileEmailText" Opacity="0.7" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Grid.Row="1"
                                            Grid.ColumnSpan="2"
                                            Orientation="Horizontal"
                                            HorizontalAlignment="Right"
                                            Spacing="8">
                                    <Button Content="Switch account" Click="GoogleSwitchAccountClick" />
                                    <Button Content="Sign out" Click="GoogleSignOutClick" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <TextBlock x:Name="GoogleConnectionStatus"
                                   Grid.Row="1"
                                   Margin="0,8,0,0"
                                   Text="Not connected"
                                   TextWrapping="Wrap" />
                    </Grid>
                    <Grid x:Name="GoogleSyncRow"
                          Grid.Row="1"
                          ColumnSpacing="12"
                          Padding="0,10"
                          Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <muxc:Button x:Name="RefreshGoogleSourcesButton"
                                     Content="Sync now"
                                     Click="RefreshGoogleSources" />
                        <TextBlock x:Name="GoogleSyncStatus"
                                   Grid.Column="1"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap" />
                    </Grid>
                    <Grid Grid.Row="2">
                        <ListView x:Name="GoogleSourceCardsList"
                                  SelectionMode="None"
                                  IsItemClickEnabled="False"
                                  ItemTemplate="{StaticResource SourceCardTemplate}" />
                    </Grid>
                </Grid>

                <Grid x:Name="CanvasPage" Padding="16" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Spacing="16">
                    <StackPanel Spacing="4">
                        <AutoSuggestBox x:Name="CanvasSchoolSelector"
                                        Header="School"
                                        PlaceholderText="Search for your school"
                                        QueryIcon="Find"
                                        MaxWidth="480"
                                        HorizontalAlignment="Left"
                                        MinWidth="320"
                                        UpdateTextOnSelect="False"
                                        GotFocus="CanvasSchoolSelectorGotFocus"
                                        LostFocus="CanvasSchoolSelectorLostFocus"
                                        TextChanged="CanvasSchoolSelectorTextChanged"
                                        QuerySubmitted="CanvasSchoolSelectorQuerySubmitted" />
                        <TextBlock x:Name="CanvasSchoolHint"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                    <Grid ColumnSpacing="12" RowSpacing="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <muxc:TextBox x:Name="CanvasCalLinkInput"
                                      Header="Canvas Calendar Feed URL"
                                      PlaceholderText="https://&lt;your-school&gt;.instructure.com/feeds/calendars/user_….ics" />
                        <muxc:Button Grid.Column="1"
                                     VerticalAlignment="Bottom"
                                     Click="CanvasSaveClick">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Image Source="ms-appx:///Assets/canvas-lms.png"
                                       Width="20"
                                       Height="20"
                                       Stretch="Uniform" />
                                <TextBlock x:Name="CanvasConnectButtonText"
                                           Text="Connect Calendar"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </muxc:Button>
                        <TextBlock x:Name="CanvasLinkStatus"
                                   Grid.Row="1"
                                   Grid.ColumnSpan="2"
                                   TextWrapping="Wrap" />
                    </Grid>
                    </StackPanel>
                    <Grid x:Name="CanvasSyncRow"
                          Grid.Row="1"
                          ColumnSpacing="12"
                          Padding="0,10"
                          Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <muxc:Button Content="Sync now" Click="RefreshCanvasSources" />
                        <TextBlock x:Name="CanvasSyncStatus"
                                   Grid.Column="1"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap" />
                    </Grid>
                    <Grid Grid.Row="2">
                        <ListView x:Name="CanvasSourceCardsList"
                                  SelectionMode="None"
                                  IsItemClickEnabled="False"
                                  ItemTemplate="{StaticResource SourceCardTemplate}" />
                    </Grid>
                </Grid>
            </Grid>
        </muxc:NavigationView>
    </Grid>
</Window>
